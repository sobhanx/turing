DJANGO_SETTINGS_MODULE=config.settings

# --- Local development ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# DATABASE_URL=   # omit → SQLite at ./db.sqlite3

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

TURING_SPEECHMATICS_API_KEY=
TURING_SPEECHMATICS_BASE_URL=https://asr.api.speechmatics.com/v2
TURING_DEFAULT_PROVIDER=speechmatics
TURING_MEDIA_ROOT=
TURING_POLL_INTERVAL_SECONDS=3
TURING_POLL_TIMEOUT_SECONDS=1800
TURING_POLL_BACKOFF_BASE_SECONDS=3
TURING_POLL_BACKOFF_MAX_SECONDS=60
TURING_MAX_POLL_ATTEMPTS=0
TURING_RETRY_BACKOFF_BASE_SECONDS=5
TURING_RETRY_BACKOFF_MAX_SECONDS=300
TURING_STORAGE_BACKEND=local
TURING_SIGNED_URL_TTL_SECONDS=3600
# TURING_S3_BUCKET=
# TURING_S3_REGION=
# TURING_S3_ACCESS_KEY=
# TURING_S3_SECRET_KEY=
# TURING_S3_ENDPOINT_URL=

# --- Production example (use with DJANGO_SETTINGS_MODULE=config.settings.production) ---
# DJANGO_SETTINGS_MODULE=config.settings.production
# DJANGO_SECRET_KEY=replace-with-long-random-secret
# DJANGO_DEBUG=false
# DJANGO_ALLOWED_HOSTS=turing.example.com
# DATABASE_URL=postgres://turing:turing@db:5432/turing
# CSRF_TRUSTED_ORIGINS=https://turing.example.com
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_SSL_REDIRECT=true
# SECURE_HSTS_SECONDS=31536000
# TURING_BEHIND_PROXY=true
# LOG_LEVEL=INFO
